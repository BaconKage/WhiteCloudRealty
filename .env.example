# Web3Forms access key — free, no backend required.
# Get one at https://web3forms.com (enter the inbox address, they email the key).
# Without this the enquiry forms fall back to a prefilled WhatsApp deep link.
NEXT_PUBLIC_WEB3FORMS_KEY=

# Canonical origin, used for sitemap.xml, robots.txt and og:url.
NEXT_PUBLIC_SITE_URL=https://www.whitecloudrealty.in
